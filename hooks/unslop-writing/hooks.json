{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(?:apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/unslop-writing.mjs\"",
            "timeout": 10,
            "statusMessage": "Reviewing edited prose with Jev"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/unslop-writing.mjs\"",
            "timeout": 10,
            "statusMessage": "Reviewing final prose with Jev"
          }
        ]
      }
    ]
  }
}
